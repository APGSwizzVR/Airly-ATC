<Application x:Class="AirlyATC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#0B0D10"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#11151A"/>
        <SolidColorBrush x:Key="PanelBrushAlt" Color="#161B21"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#252C34"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F7FA"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#929BA6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4DA3FF"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#45C486"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#E5B65A"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E86C6C"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrushAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
