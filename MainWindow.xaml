<Window x:Class="AirlyATC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Airly ATC"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="AIRLY" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text=" ATC" FontSize="25" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                <Border Margin="16,0,0,0" Padding="9,4" Background="{StaticResource PanelBrushAlt}" CornerRadius="6">
                    <TextBlock Text="NETWORK" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/>
                <TextBlock Text="Network online" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,20,0"/>
                <TextBlock Text="AIRLY-ATC-DEV" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Controller workspace" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Control any supported global ATC position. Unstaffed positions automatically use Airly AI."
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <TextBox x:Name="SearchBox"
                         Background="Transparent"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         BorderThickness="0"
                         FontSize="14"
                         VerticalContentAlignment="Center"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="ATC positions" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Human ownership and AI fallback"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="PositionList"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="PositionList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrushAlt}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding AirportIcao}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding PositionName}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Frequency}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ControllerLabel}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding QueueLabel}" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Position" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="SelectedPositionText" Text="Select an ATC position" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        <TextBlock x:Name="SelectedAirportText" Text="Choose an airport position from the left." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,30,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource PanelBrushAlt}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="CONTROL STATUS" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="ControlStatusText" Text="AIRLY AI" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                <TextBlock x:Name="FrequencyText" Text="—" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="QueueText" Text="Queue empty" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource PanelBrushAlt}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="LIVE TRAFFIC" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="0" FontSize="38" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                <TextBlock Text="Aircraft currently visible to this position" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="QueueButton" Content="Join Queue" Click="QueueButton_OnClick" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button x:Name="ControlButton" Content="Take Control" Click="ControlButton_OnClick" IsEnabled="False" Background="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
