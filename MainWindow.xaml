<Window x:Class="AirlyATC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Airly ATC"
        Width="1680" Height="980"
        MinWidth="1250" MinHeight="760"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="82"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="AIRLY" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text=" ATC" FontSize="24" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                <Border Margin="14,0,0,0" Padding="8,4" Background="{StaticResource PanelBrushAlt}" CornerRadius="5">
                    <TextBlock Text="CONTROLLER CLIENT" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                <TextBlock Text="NETWORK CONNECTED" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,18,0"/>
                <TextBlock x:Name="ClockText" Text="00:00:00Z" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="WORLD" Margin="0,0,6,0" Click="WorldButton_Click"/>
                <Button Content="AIRPORT" Margin="0,0,6,0" Click="AirportButton_Click"/>
                <Button Content="RADAR" Margin="0,0,6,0" Click="RadarButton_Click"/>
                <Button Content="STRIPS" Margin="0,0,6,0" Click="StripsButton_Click"/>
                <Button Content="ATIS" Margin="0,0,6,0" Click="AtisButton_Click"/>
                <Button Content="SETTINGS" Click="SettingsButton_Click"/>
            </StackPanel>
            <TextBox x:Name="SearchBox" Width="300" HorizontalAlignment="Right" TextChanged="SearchBox_OnTextChanged"
                     Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                     ToolTip="Search airport, position or frequency"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="POSITIONS" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="Worldwide ATC" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="PositionList" Background="Transparent" BorderThickness="0" SelectionChanged="PositionList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrushAlt}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AirportIcao}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding PositionName}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Frequency}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ControllerLabel}" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding QueueLabel}" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#070B0D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Canvas x:Name="RadarCanvas" Background="#061012"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8" Background="#B0090D0F" BorderBrush="#304047" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock x:Name="ScopeTitle" Text="EIDW TWR • 118.600" FontWeight="SemiBold"/>
                            <TextBlock Text="RADAR SCOPE" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                        <Border Padding="7" Background="#B0090D0F" BorderBrush="#304047" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="RANGE" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="80 NM" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Button Content="+" Width="32" Height="30" Margin="0,6,0,0" Click="ZoomIn_Click"/>
                        <Button Content="−" Width="32" Height="30" Click="ZoomOut_Click"/>
                    </StackPanel>
                    <TextBlock Text="N" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="AIRLY SIMULATED RADAR" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="9" Foreground="#607078"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="250"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="FLIGHT STRIPS" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="TrafficCountText" Text="0 aircraft" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ListBox x:Name="StripList" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrushAlt}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding AircraftType}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding Route}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Altitude}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Squawk}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
                    <StackPanel>
                        <TextBlock Text="POSITION CONTROL" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="SelectedPositionText" Text="EIDW TWR" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="SelectedAirportText" Text="Dublin Airport • 118.600 MHz" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="ControlStatusText" Text="AIRLY AI" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="QueueText" Text="No queue" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ControlButton" Content="TAKE CONTROL" Click="ControlButton_OnClick" Margin="0,0,6,0"/>
                            <Button x:Name="QueueButton" Content="JOIN QUEUE" Click="QueueButton_OnClick" Margin="0,0,6,0"/>
                            <Button x:Name="ReleaseButton" Content="RELEASE" Click="ReleaseButton_OnClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="COM1" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="Com1Text" Text="118.600" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" x:Name="RadioMessageBox" Margin="10,0" VerticalContentAlignment="Center" Text="Ready. Radio channel connected."/>
                    <Button Grid.Column="2" Content="SEND" Click="SendMessage_Click"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="VOICE" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="CONNECTED" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="PTT" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="SPACE" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="RX" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="118.600" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
